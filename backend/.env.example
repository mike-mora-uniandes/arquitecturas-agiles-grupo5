# Copia este archivo a .env y ajusta si hace falta:  cp .env.example .env
# docker compose lo carga vía 'env_file: .env' en cada microservicio.

# --- Broker de mensajería (RabbitMQ / AMQP) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# --- Caché de datos externos (solo MS PerfilRiesgo) ---
REDIS_URL=redis://redis:6379/0

# --- Fuentes externas simuladas con Wiremock (solo MS PerfilRiesgo) ---
OPEN_DATA_URL=http://wiremock:8080/open-data
OPEN_FINANCE_URL=http://wiremock:8080/open-finance

# --- Parámetros de las tácticas de disponibilidad (MS PerfilRiesgo) ---
# Aún sin implementar; se dejan como contrato de configuración.
DETECTION_TIMEOUT_MS=700       # ASR1: umbral de detección de fallo
RETRY_MAX=3                    # ASR3: número máximo de reintentos
RETRY_BACKOFF_BASE_MS=200      # ASR3: base del backoff exponencial
RETRY_BUDGET_MS=5000           # ASR3: presupuesto total de reintentos
CACHE_TTL_S=86400            # ASR2: validez del valor de respaldo en caché

# --- Idempotencia (MS PerfilRiesgo) ---
PROCESSED_TTL_S=3600         # vida de la clave processed:{correlation_id}

# --- Worker Celery (MS PerfilRiesgo) ---
CELERY_CONCURRENCY=4

# --- Observabilidad (OpenTelemetry) ---
# Por defecto SIN telemetría (logs limpios en el modo normal).
# Para una corrida con métricas: OTEL_SDK_DISABLED=false, OTEL_TRACES_EXPORTER=otlp,
# OTEL_METRICS_EXPORTER=otlp  (y  docker compose --profile experimento up).
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=solventa,deployment.environment=experimento
# Intervalo de exportación de métricas (por defecto OTel son 60 s; 5 s para ver
# los ASR casi en vivo en Grafana durante la corrida).
OTEL_METRIC_EXPORT_INTERVAL=5000

# --- Común ---
FLASK_ENV=development
LOG_LEVEL=INFO
