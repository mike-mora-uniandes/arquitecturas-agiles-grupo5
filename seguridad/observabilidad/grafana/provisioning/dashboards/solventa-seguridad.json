      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(solventa_seguridad_intrusiones_total{tipo=\"confidencialidad\"})"
        }
      ]
    },
    {
      "id": 112,
      "type": "stat",
