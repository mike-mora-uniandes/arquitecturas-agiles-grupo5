        "orientation": "horizontal",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(solventa_seguridad_asr1_within_threshold_total{pass=\"true\"}) / sum(solventa_seguridad_asr1_within_threshold_total)"
        }
