{
  "uid": "solventa-seguridad",
  "title": "Solventa - Experimento de seguridad (Confidencialidad + Integridad)",
  "description": "Deteccion (ASR1/ASR2) y notificacion (ASR3/ASR4) de intrusiones de confidencialidad e integridad del perfil de riesgo.",
  "tags": [
    "solventa",
    "seguridad"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Resumen del experimento de seguridad",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Intrusiones detectadas (total)",
      "description": "Confidencialidad + integridad juntas. Ver el desglose por tipo en los dos paneles de la derecha.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(solventa_seguridad_intrusiones_total)"
        }
      ]
    },
    {
      "id": 110,
      "type": "stat",
      "title": "Requests procesadas (total)",
      "description": "Todas las peticiones que ms-audit evaluó, sean o no intrusion. Denominador para leer los otros 3 numeros de esta fila.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(solventa_seguridad_requests_total)"
        }
      ]
    },
    {
      "id": 111,
      "type": "stat",
      "title": "Incidentes de confidencialidad",
      "description": "BOLA (acceso_no_autorizado) + comportamiento anomalo, sumados. Detalle de la clasificacion en 'Trafico observado', al final del dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
