# Copia este archivo a .env y ajusta si hace falta: cp .env.example .env
# docker compose lo carga vía 'env_file: .env' en cada microservicio.

# --- Broker de mensajería (RabbitMQ / AMQP) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_EXCHANGE=solventa-seguridad

# --- Evento ReporteExtraccionPerfilRiesgoCliente (ms-riesgo -> ms-audit) ---
# Los defaults en código ya coinciden entre ambos servicios; solo hace falta
# tocar esto si se quiere renombrar la cola/routing key/tarea.
EXTRACCION_QUEUE=audit.extraccion_perfil.q
EXTRACCION_ROUTING_KEY=riesgo.extraccion_perfil
EXTRACCION_TASK_NAME=audit.registrar_extraccion_perfil

# --- Bases de datos (una por servicio) ---
IDENTIDAD_DATABASE_URL=postgresql://solventa:solventa@ms-identidad-db:5432/identidad
RIESGO_DATABASE_URL=postgresql://solventa:solventa@ms-riesgo-db:5432/perfilriesgo
AUDIT_DATABASE_URL=postgresql://solventa:solventa@ms-audit-db:5432/audit

# --- Evento IntegridadFallida (ms-cliente -> ms-audit) ---
# Lo publica ms-cliente cuando el hash del perfil no coincide (ASR2). Los
# defaults en código ya coinciden entre ambos servicios; solo hace falta
# tocar esto para renombrar la cola/routing key/tarea.
INTEGRIDAD_QUEUE=audit.integridad_fallida.q
INTEGRIDAD_ROUTING_KEY=cliente.integridad_fallida
INTEGRIDAD_TASK_NAME=audit.registrar_integridad_fallida

# --- Evento NotificacionIncidenteSeguridad (ms-audit -> ms-notificaciones) ---
INCIDENTE_QUEUE=notificaciones.incidente.q
INCIDENTE_ROUTING_KEY=audit.incidente_seguridad
NOTIFICAR_INCIDENTE_TASK_NAME=notificaciones.notificar_incidente

# --- Umbrales de los ASR (para las señales de cumplimiento en las métricas) ---
ASR1_UMBRAL_MS=200            # detección confidencialidad
ASR2_UMBRAL_MS=500            # detección integridad
ASR_NOTIFICACION_UMBRAL_MS=5000   # reacción (ASR3/ASR4)

# --- Clasificador de intrusiones (ms-audit) ---
# País/device del atacante simulados (dummy, no GeoIP real).
PAISES_ANOMALOS=IR,KP,SY
DEVICES_ANOMALOS=unknown-device
VENTANA_CORRELACION_S=60

# --- Secretos (solo para el experimento local — no usar en producción) ---
JWT_SECRET=change-me
INTEGRITY_SECRET=change-me

# --- Seed (Faker) ---
SEED_N_CLIENTES=10
# Escenarios reproducibles de la semilla:
#   baseline = tráfico mayoritariamente legítimo
#   attack   = mezcla de tráfico legítimo + sospechoso para pruebas de ASR1/ASR2
#SEED_SCENARIO=baseline
SEED_SCENARIO=attack
SEED_SEED=20240601
SEED_ATTACK_RATIO=0.20

# --- Observabilidad (OpenTelemetry) ---
# Desactivada por defecto (meter/tracer no-op). Para una corrida con métricas:
# poner OTEL_SDK_DISABLED=false, *_EXPORTER=otlp, y levantar con
# `docker compose --profile experimento up`.
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=solventa-seguridad,deployment.environment=experimento
OTEL_METRIC_EXPORT_INTERVAL=5000

# --- Común ---
LOG_LEVEL=INFO
